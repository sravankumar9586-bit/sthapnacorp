{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "30 2 * * *"
    }
  ],
  "functions": {
    "api/cron-reminders.js": {
      "maxDuration": 60
    },
    "api/updates.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sthapnacorp.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/expense",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/expense",
      "destination": "/api/services?x=expense"
    }
  ]
}
